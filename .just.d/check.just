# run go vet
[group('~checks:default')]
vet:
    just _banner ">> running go vet"
    #go vet $(go list ./... | grep -v "github.com/dropwhile/???")
    go vet ./...

# run staticcheck
[group('~checks:default')]
staticcheck: (_banner ">> running staticcheck")
    staticcheck ./...

# run revive
[group('~checks:default')]
revive: (_banner ">> running revive")
    revive -config .revive.toml -formatter friendly ./...

# run errcheck
[group('~checks:default')]
errcheck: (_banner ">> running errcheck")
    errcheck \
        -ignoretests \
        -exclude .errcheck-excludes.txt \
        ./...

# run errortype
[group('~checks:default')]
errortype: (_banner ">> running errortype")
    errortype ./...

# run nilness
[group('~checks:default')]
nilness: (_banner ">> running nilness")
    nilness ./...

# run ineffassign
[group('~checks:default')]
ineffassign: (_banner ">> running ineffassign")
    ineffassign ./...

# run govulncheck
[group('~checks:default')]
govulncheck: (_banner ">> running govulncheck")
    govulncheck ./...

# run betteralign
[group('~checks:default')]
betteralign: (_banner ">> running betteralign")
    betteralign ./...

# run gosec
[group('~checks:default')]
gosec: (_banner ">> running gosec")
    gosec \
        -quiet \
        -exclude-generated \
        ./...

# run nilaway (will have false positives)
[group('~checks:optional')]
nilaway: (_banner ">> running nilaway")
    -nilaway -test=false \
        -include-pkgs "codeberg.org/dropwhile/go-camo" \
        -exclude-file-docstrings "@generated,Code generated by,Autogenerated by" \
        ./...

# run deadcode (will have false positives)
[group('~checks:optional')]
deadcode: (_banner ">> running deadcode")
    -deadcode -test ./...

# run errorlint (will have false positives)
[group('~checks:optional')]
errorlint: (_banner ">> running errorlint")
    -go-errorlint ./...

# run all ~checks:default checkers
[group('checks')]
check: vet staticcheck revive errcheck errortype nilness ineffassign govulncheck betteralign gosec

# run all ~checks:optional checkers
[group('checks')]
check-optional: nilaway deadcode errorlint
